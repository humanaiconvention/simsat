# SimSat — environment variables
# Copy to `.env` (gitignored) and fill in. Defaults shown work for the
# zero-credentials demo path (Sentinel-only, clip_local backend, CPU).

# ============================================================================
# Imagery providers
# ============================================================================

# Optional. If unset, all Mapbox endpoints return 503 and the encounter planner
# runs no-Mapbox-safe (Sentinel + orbital geometry only).
# Get a token at https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=

# ============================================================================
# ObservationVLA backend selection
# ============================================================================

# Which model assesses each observation window. Default: clip_local.
# Options:
#   clip_local        — CLIP baseline (default, no fine-tuning)
#   gemma4            — SimSat Gemma-4-E2B fine-tune (Kaggle benhaslam/simsat-gemma4-v1-training).
#                       Reads the OBSERVATION_VLM_* env vars for paths.
#   gemma4_haic_local — Legacy HAIC v35-gov Gemma-4 (human-interview model — wrong task!).
#                       Reads the HAIC_GEMMA4_* env vars below.
#   genesis           — Guilherme's Genesis (reads GENESIS_* below)
#   tesseract_t3      — Garrett's Tesseract T3 (reads TESSERACT_T3_* below)
#   transformers_vlm  — generic (reads OBSERVATION_VLM_* below)
#   stub              — no model load (testing only)
OBSERVATION_VLA_BACKEND=clip_local

# Compute device for local inference. cpu | cuda | cuda:0 ...
OBSERVATION_VLA_DEVICE=cpu

# Optional: force a specific HuggingFace model id for the auto adapter
# OBSERVATION_VLA_MODEL=openai/clip-vit-base-patch32

# Remote endpoint mode (only used when OBSERVATION_VLA_BACKEND=endpoint)
# OBSERVATION_VLA_ENDPOINT=https://your-vla-endpoint.example.com/predict

# ============================================================================
# SimSat Gemma-4 fine-tune (general-AI track)
# Used when OBSERVATION_VLA_BACKEND=gemma4 (recommended for the SimSat fine-tune).
# Routes through TransformersVLMAdapter which reads OBSERVATION_VLM_* below.
# ============================================================================
# OBSERVATION_VLM_MODE=lora                          # lora | merged | gguf
# OBSERVATION_VLM_BASE_MODEL=google/gemma-4-e2b-it
# OBSERVATION_VLM_LORA_PATH=./weights/gemma4-v7/adapter
# OBSERVATION_VLM_MODE=lora
# OBSERVATION_VLM_MODEL_LABEL=gemma4-simsat

# ============================================================================
# Legacy: Gemma-4 HAIC v35-gov (human-interview / consent-governance model)
# Only used when OBSERVATION_VLA_BACKEND=gemma4_haic_local. NOT what you want
# for SimSat — wrong task shape. Kept for reference / regression testing.
# ============================================================================
# HAIC_GEMMA4_MODE=lora                      # lora | merged | gguf
# HAIC_GEMMA4_BASE_MODEL=google/gemma-4-e2b-it
# HAIC_GEMMA4_LORA_PATH=./weights/haic-v35-gov/adapter
# HAIC_GEMMA4_MERGED_PATH=./weights/haic-v35-gov/base
# HAIC_GEMMA4_GGUF_PATH=./weights/haic-v35-gov/gguf/1.F16.gguf
# HAIC_GEMMA4_WEIGHTS_DIR=./weights/haic-v35-gov

# ============================================================================
# Genesis collaborator slot (Guilherme)
# ============================================================================
# GENESIS_MODE=lora                          # lora | merged | gguf
# GENESIS_BASE_MODEL=your-hf-org/genesis-152m
# GENESIS_LORA_PATH=./weights/genesis/adapter
# GENESIS_MERGED_PATH=./weights/genesis/base
# GENESIS_GGUF_PATH=./weights/genesis/gguf/genesis.gguf
# GENESIS_WEIGHTS_DIR=./weights/genesis
# GENESIS_MODEL_LABEL=genesis
# GENESIS_REPO_PATH=/path/to/genesis-repo      # For native Genesis loader
# GENESIS_WEIGHTS_PATH=/path/to/genesis-weights

# ============================================================================
# Tesseract T3 collaborator slot (Garrett)
# ============================================================================
# TESSERACT_T3_MODE=lora                     # lora | merged | gguf
# TESSERACT_T3_BASE_MODEL=your-hf-org/tesseract-t3
# TESSERACT_T3_LORA_PATH=./weights/tesseract-t3/adapter
# TESSERACT_T3_MERGED_PATH=./weights/tesseract-t3/base
# TESSERACT_T3_GGUF_PATH=./weights/tesseract-t3/gguf/tesseract-t3.gguf
# TESSERACT_T3_WEIGHTS_DIR=./weights/tesseract-t3
# TESSERACT_T3_MODEL_LABEL=tesseract-t3

# ============================================================================
# Generic transformers VLM adapter (any other backend)
# ============================================================================
# OBSERVATION_VLM_MODE=lora
# OBSERVATION_VLM_BASE_MODEL=
# OBSERVATION_VLM_LORA_PATH=./weights/observation-vlm/adapter
# OBSERVATION_VLM_MERGED_PATH=./weights/observation-vlm/base
# OBSERVATION_VLM_GGUF_PATH=./weights/observation-vlm/gguf/model.gguf
# OBSERVATION_VLM_WEIGHTS_DIR=./weights/observation-vlm
# OBSERVATION_VLM_MODEL_LABEL=
# OBSERVATION_VLM_DEVICE=cpu

# ============================================================================
# Path overrides for external systems (e.g., PRISM integration)
# ============================================================================
# PRISM_SRC_PATH=/path/to/prism/src           # For PRISM module loading (haic/prism_loop.py)

# ============================================================================
# Dataset preparation parameters
# ============================================================================
# REFINE_BOOST=1.0                            # Upweight 'refine' action cases during dataset prep
#                                              # Default 1.0 (no boost). Set to 2.0+ to mitigate
#                                              # accept-bias in models trained on imbalanced data.
#                                              # Run: REFINE_BOOST=2.0 python datasets/simsat-gemma4-v1/prepare_dataset.py

# ============================================================================
# API rate limiting
# ============================================================================
# SENTINEL_MAPBOX_RATE_LIMIT=30/minute        # Rate limit for Sentinel/Mapbox imagery endpoints
#                                              # Format: "N/second", "N/minute", "N/hour". Default: 30/minute.
